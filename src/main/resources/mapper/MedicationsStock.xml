<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.seoulit.his.pharmacyservice.inventory.mapper.MedicationsStock">

    <resultMap id="stockRow" type="map"/>

    <select id="medicationsStock"
            statementType="CALLABLE"
            parameterType="map">
        {call PHARMACY.PROC_PHARMACY_2(
            #{input},
            #{stockList, mode=OUT, jdbcType=CURSOR, javaType=java.sql.ResultSet, resultMap=stockRow}
        )}
    </select>

</mapper>
